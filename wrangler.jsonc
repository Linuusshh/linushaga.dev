{
  "name": "linushaga-dev",
  "compatibility_date": "2026-11-15",
  // Static assets only: no Worker script, Cloudflare serves ./public directly.
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "linushaga.dev", "custom_domain": true },
    { "pattern": "www.linushaga.dev", "custom_domain": true }
  ]
}
